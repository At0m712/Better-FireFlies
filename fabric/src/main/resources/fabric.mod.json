{
    "schemaVersion": 1,
    "id": "firefly",
    "version": "${version}",
    "name": "Better FireFlies",
    "description": "A client-side ambient mod adding decorative 3D fireflies with glowing bioluminescence and smooth dynamic light support.",
    "authors": [
        "Atom"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/firefly"
    },
    "license": "MIT",
    "icon": "assets/firefly/icon.png",
    "environment": "client",
    "entrypoints": {
        "main": [
            "com.atom.firefly.fabric.FireflyFabric"
        ],
        "client": [
            "com.atom.firefly.fabric.client.FireflyFabricClient"
        ]
    },
    "mixins": [
        "firefly.mixins.json",
        "firefly.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.15.11",
        "minecraft": ">=1.21 <=1.21.11",
        "java": ">=21",
        "fabric-api": "*"
    }
}